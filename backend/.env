# API Keys
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# App Configuration
DEBUG=True
API_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Model Settings
OPENAI_MODEL=gpt-4
MAX_TOKENS=2000
TEMPERATURE=0.7
